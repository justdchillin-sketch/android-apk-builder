# Collect all arguments for the java command, stacking in reverse order:
#   * args from the command line
#   * the main class name
#   * -classpath
#   * -D...appname settings
#   * --module-path (only if needed)
#   * DEFAULT_JVM_OPTS, JAVA_OPTS, and GRADLE_OPTS environment variables.

# For Cygwin or MSYS, switch paths to Windows format before running java
if "$cygwin" || "$msys" ; then
    APP_HOME=$(cygpath --path --mixed "$APP_HOME")
    CLASSPATH=$(cygpath --path --mixed "$CLASSPATH")

    JAVACMD=$(cygpath --unix "$JAVACMD")

    # We need to detect if we are using a Windows version of Java that uses the
    # Windows path style for classpath arguments. If so, we need to convert the
    # classpath to Windows style before passing it to Java.
    # The 'cygpath' command can be used to do this.
    # The '-w' flag converts the path to Windows style.
    # The '-p' flag is used to indicate that the path is a classpath.
    # We need to ensure that the classpath is converted to Windows style before
    # passing it to Java.
    # The 'cygpath' command can be used to do this.
    # The '-w' flag converts the path to Windows style.
    # The '-p' flag is used to indicate that the path is a classpath.
    if [ "$cygwin" = "true" ]; then
        CLASSPATH=$(cygpath --path --windows "$CLASSPATH")
    fi
fi

exec "$JAVACMD" \
  $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain \
  "$@"
